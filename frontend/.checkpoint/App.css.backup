
/* SecureShare dashboard theme fixes */

body {
  background: #0f172a;
  color: #e2e8f0;
}

.dashboard {
  color: #e2e8f0;
}

.dashboard-header h1 {
  color: #60a5fa;
}

.account-panel,
.files-panel {
  background: #1e293b;
  color: #e2e8f0;
  border: 1px solid #334155;
}

.account-panel h3,
.files-panel h3 {
  color: #f8fafc;
}

.account-panel p,
.files-panel p {
  color: #cbd5e1;
}

.account-panel strong {
  color: #f8fafc;
}

.welcome-panel {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: #ffffff;
}

.welcome-panel h2,
.welcome-panel p {
  color: #ffffff;
}

.logout-btn {
  background: #1e293b;
  color: #f8fafc;
  border: 1px solid #475569;
}

.logout-btn:hover {
  background: #334155;
}

.status {
  color: #4ade80 !important;
}

.status-dot {
  background: #4ade80;
}
